# ═══════════════════════════════════════════════════════════
# CERO — Variables de entorno
# Copiar a .env en local. En Railway: configurar en el dashboard.
# Fuente de verdad: config/config.js (REQUIRED_VARS hace process.exit(1) si falta alguna OBLIGATORIA)
# ═══════════════════════════════════════════════════════════

# ── OBLIGATORIAS (el servicio NO arranca sin estas 6) ──────
GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
JWT_SECRET=

# ── Servidor ───────────────────────────────────────────────
PORT=8080
# NODE_ENV=production  # Railway la inyecta; en local dejar sin definir para cargar .env

# ── Twilio / WhatsApp ──────────────────────────────────────
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL pública del webhook para validar firma Twilio (alias aceptado: PUBLIC_WEBHOOK_URL)
TWILIO_WEBHOOK_URL=
# Solo desarrollo local (en producción se ignora y bloquea):
# DISABLE_TWILIO_SIGNATURE_VALIDATION=true

# ── Gemini ─────────────────────────────────────────────────
GOOGLE_MODEL_VISION=gemini-2.5-flash
GOOGLE_MODEL_NOVEDADES=gemini-2.5-flash

# ── Reglas de negocio ──────────────────────────────────────
MAX_KM_SALTO=200

# ── Storage ────────────────────────────────────────────────
STORAGE_BUCKET_PREOPERACIONALES=preoperacionales
STORAGE_BUCKET_POSOPERACIONALES=preoperacionales

# ── Alertas ────────────────────────────────────────────────
ALERTAS_CANAL=log

# ── Tablas (defaults correctos en config.js — solo definir para override) ──
# v26: la tabla vehiculos NO existe — todo opera sobre activos
# DB_TABLE_ACTIVOS=activos
# DB_TABLE_CONDUCTORES=conductores
# DB_TABLE_PREOPERACIONALES=preoperacionales
# DB_TABLE_POSOPERACIONALES=posoperacionales
# DB_TABLE_TANQUEOS=tanqueos
# DB_TABLE_EVIDENCIA=evidencia
# DB_TABLE_FOTOS_TANQUEO=evidencia
# DB_TABLE_ALERTAS=alertas
# DB_TABLE_ATS=ats
# DB_TABLE_REVISIONES_EQUIPOS=revisiones_equipos
# DB_TABLE_RIESGOS_LOCATIVOS=riesgos_locativos
# DB_TABLE_DASHBOARD_SNAPSHOTS=dashboard_snapshots
# DB_TABLE_SESIONES_ACTIVAS=sesiones_activas
